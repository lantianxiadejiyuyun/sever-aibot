# Control-plane environment. Copy to /etc/server-aibot/control.env with mode 0600.
# Never commit the real file.

# Listen on loopback only; expose it through a TLS reverse proxy or SSH tunnel.
AIBOT_LISTEN=127.0.0.1:7400

# SQLite database path.
AIBOT_DB=/var/lib/server-aibot/aibot.sqlite3

# 32 random bytes, base64. Generate once and back it up separately from the
# database: losing it makes encrypted credentials unrecoverable.
#   openssl rand -base64 32
AIBOT_MASTER_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# Read only on first start. The value is hashed with a memory-hard algorithm and never
# written back to disk. Remove this line after the administrator exists.
AIBOT_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
AIBOT_ADMIN_USER=admin

# Set to 1 when the panel is served over HTTPS.
AIBOT_SECURE_COOKIE=1

# Public hostname the browser uses when the control plane runs behind a
# reverse proxy. It is accepted as an Origin host for CSRF-protected requests
# (the request Host is then the upstream address).
# AIBOT_PUBLIC_HOST=panel.example.com

# Optional native TLS. When both are set the process serves HTTPS directly and
# no reverse proxy is needed. Set both or neither.
# AIBOT_TLS_CERT=/etc/server-aibot/tls/control.crt
# AIBOT_TLS_KEY=/etc/server-aibot/tls/control.key

# Text logs by default; set to json for log shipping.
AIBOT_LOG_FORMAT=text
AIBOT_LOG_LEVEL=info
