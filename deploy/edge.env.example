# SNI edge environment. Copy to /etc/server-aibot/edge.env with mode 0600.
# Never commit the real file.
#
# The edge puts the console and the node tunnel on one TLS port without a
# reverse proxy: it reads the ClientHello server name and forwards the original
# bytes to the matching listener, which keeps end-to-end TLS and its certificate.

AIBOT_EDGE_LISTEN=0.0.0.0:443

# name=host:port pairs. Names are matched case-insensitively, without a port.
AIBOT_EDGE_ROUTES=aibot.example.com=127.0.0.1:7400,node.example.com=127.0.0.1:7000

# Optional upstream for server names that have no route. Empty refuses them.
# AIBOT_EDGE_DEFAULT=127.0.0.1:7400

AIBOT_LOG_FORMAT=text
AIBOT_LOG_LEVEL=info
