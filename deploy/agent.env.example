# Agent environment. Copy to /etc/server-aibot/agent.env with mode 0600.
# Never commit the real file.

# Control-plane base URL. https/http are converted to wss/ws automatically.
AIBOT_CONTROL_URL=https://panel.example.com

# Issued in the console when the device is created. The key is shown once.
AIBOT_DEVICE_ID=CHANGE_ME_DEVICE_ID
AIBOT_DEVICE_KEY=CHANGE_ME_DEVICE_KEY

# Local state directory. Created with mode 0700. Secrets are never written here.
AIBOT_AGENT_STATE=/var/lib/server-aibot-agent

# Tunnel target policy. RFC1918 and IPv6 ULA are always allowed. Add public
# ranges only when a forward must reach them; loopback ports are allowed only
# when listed explicitly.
# AIBOT_RELAY_ALLOW_CIDRS=203.0.113.10/32,198.51.100.0/24
# AIBOT_RELAY_LOOPBACK_PORTS=8080
# AIBOT_RELAY_ALLOW_LINK_LOCAL=0
