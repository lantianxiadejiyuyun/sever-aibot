# Generate unique secrets with deploy/init_env.py; do not use this file as credentials.
AIBOT_ADMIN_PASSWORD=
AIBOT_MASTER_KEY=
GOSTC_CONTROL_SECRET=
AIBOT_DB=/var/lib/server-aibot/platform.sqlite3
GOSTC_CONTROL_URL=http://127.0.0.1:18081
GOSTC_ADMIN_ADDR=127.0.0.1:18081
AIBOT_COOKIE_SECURE=1
# Only enable this on a control host actually located outside the target network.
AIBOT_EXTERNAL_PROBE=0
# Contact URL or mailto for Web Push; absence leaves native push disabled.
AIBOT_VAPID_SUBJECT=
