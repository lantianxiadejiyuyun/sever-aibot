#!/bin/sh /etc/rc.common
# OpenWrt/iStoreOS: restore the Compose service after storage and Docker.
START=99
STOP=10
extra_command "status" "Check whether the Agent container is running"

start() {
    local compose timeout elapsed
    /usr/sbin/aibot-storage-ready || return 1
    compose="$(uci -q get server_aibot.agent.compose_file)" || return 1
    [ -f "$compose" ] || { logger -t server-aibot-agent "Compose file missing: $compose"; return 1; }
    timeout=30
    elapsed=0
    if ! docker info >/dev/null 2>&1; then
        /etc/init.d/dockerd start || return 1
    fi
    until docker info >/dev/null 2>&1; do
        [ "$elapsed" -lt "$timeout" ] || { logger -t server-aibot-agent 'Docker startup timed out'; return 1; }
        sleep 1
        elapsed=$((elapsed + 1))
    done
    docker compose -f "$compose" up -d --no-build
}

stop() {
    if docker container inspect server-aibot-agent >/dev/null 2>&1; then
        docker stop -t 20 server-aibot-agent
    fi
}

status() {
    [ "$(docker inspect --format '{{.State.Running}}' server-aibot-agent 2>/dev/null)" = true ]
}
