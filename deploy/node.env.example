# Relay-node runtime environment. Copy to /etc/server-aibot/node.env with mode
# 0600. Never commit the real file.

# Control-plane base URL. https/http are converted to wss/ws automatically.
AIBOT_CONTROL_URL=https://panel.example.com

# Issued in the console when the node is created. The key is shown once and
# only its hash is stored server-side.
AIBOT_NODE_ID=CHANGE_ME_NODE_ID
AIBOT_NODE_KEY=CHANGE_ME_NODE_KEY

# Address intranet agents dial. Must match the node's "接入地址" field.
AIBOT_NODE_TUNNEL_LISTEN=0.0.0.0:7000

# Entry ports are bound on this address. Use a specific public IP if the node
# has several.
AIBOT_NODE_ENTRY_HOST=0.0.0.0

# Optional TLS for the agent→node tunnel. The certificate must be valid for
# the host in AIBOT_NODE_*_ADDR; agents verify it with system roots.
# AIBOT_NODE_TLS_CERT=/etc/server-aibot/node.crt
# AIBOT_NODE_TLS_KEY=/etc/server-aibot/node.key

# Serve the tunnel as a WebSocket at /tunnel instead of a raw TLS stream.
# Set to 1 when nginx (or another reverse proxy) terminates TLS and forwards
# wss://node.example.com/tunnel to this listener. Agents then use a node
# address of the form wss://node.example.com.
# AIBOT_NODE_TUNNEL_HTTP=1

AIBOT_NODE_STATE=/var/lib/server-aibot-node
AIBOT_LOG_FORMAT=text
AIBOT_LOG_LEVEL=info
