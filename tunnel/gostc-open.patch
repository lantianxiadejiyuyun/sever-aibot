diff --git a/client/aiagent/main.go b/client/aiagent/main.go
new file mode 100644
index 0000000..9e0ae69
--- /dev/null
+++ b/client/aiagent/main.go
@@ -0,0 +1,76 @@
+package main
+
+import (
+	"flag"
+	"fmt"
+	"gostc-sub/internal/service"
+	visitor "gostc-sub/internal/service/visitor"
+	"net"
+	"os"
+	"os/signal"
+	"strconv"
+	"syscall"
+)
+
+type address struct {
+	host   string
+	secure bool
+}
+
+func (a address) WsUrl() string {
+	if a.secure {
+		return "wss://" + a.host
+	}
+	return "ws://" + a.host
+}
+func (a address) HttpUrl() string {
+	if a.secure {
+		return "https://" + a.host
+	}
+	return "http://" + a.host
+}
+func main() {
+	role := flag.String("role", "client", "node, client, or visitor")
+	addr := flag.String("addr", "127.0.0.1:18081", "control host:port")
+	tls := flag.Bool("tls", true, "use TLS (plaintext only on loopback)")
+	port := flag.Int("port", 9000, "local visitor port")
+	flag.Parse()
+	host, sp, err := net.SplitHostPort(*addr)
+	pn, e := strconv.Atoi(sp)
+	if err != nil || e != nil || host == "" || pn < 1 || pn > 65535 || (!*tls && !(net.ParseIP(host).IsLoopback() || host == "localhost")) {
+		fmt.Fprintln(os.Stderr, "invalid address or unsafe plaintext connection")
+		os.Exit(2)
+	}
+	key := os.Getenv("GOSTC_AGENT_KEY")
+	if key == "" {
+		fmt.Fprintln(os.Stderr, "set GOSTC_AGENT_KEY")
+		os.Exit(2)
+	}
+	a := address{*addr, *tls}
+	var svc interface {
+		Start() error
+		Stop()
+	}
+	switch *role {
+	case "node":
+		svc = service.NewNode(a, key, "")
+	case "client":
+		svc = service.NewClient(a, key)
+	case "visitor":
+		if *port < 1 || *port > 65535 {
+			os.Exit(2)
+		}
+		svc = visitor.NewP2P(a, key, "127.0.0.1", *port)
+	default:
+		fmt.Fprintln(os.Stderr, "unknown role")
+		os.Exit(2)
+	}
+	if err := svc.Start(); err != nil {
+		fmt.Fprintln(os.Stderr, "cannot start; verify registration and connection")
+		os.Exit(1)
+	}
+	stop := make(chan os.Signal, 1)
+	signal.Notify(stop, os.Interrupt, syscall.SIGTERM)
+	<-stop
+	svc.Stop()
+}
