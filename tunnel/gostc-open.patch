diff --git a/server/service/public/frp/visitor_auth.go b/server/service/public/frp/visitor_auth.go
new file mode 100644
index 0000000..7a0933a
--- /dev/null
+++ b/server/service/public/frp/visitor_auth.go
@@ -0,0 +1,20 @@
+package service
+
+import (
+	"server/repository"
+	"server/repository/cache"
+	"strings"
+)
+
+func loginCode(user, pass string) string {
+	if !strings.HasPrefix(user, "visitor:") {
+		return cache.GetGostAuth(user, pass)
+	}
+	db, _, _ := repository.Get("")
+	t := db.GostClientP2P
+	obj, err := t.Where(t.Code.Eq(strings.TrimPrefix(user, "visitor:")), t.VKey.Eq(pass), t.Enable.Eq(1)).First()
+	if err != nil {
+		return ""
+	}
+	return obj.Code
+}
