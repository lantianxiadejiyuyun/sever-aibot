diff --git a/server/service/engine/ack.go b/server/service/engine/ack.go
new file mode 100644
index 0000000..603895a
--- /dev/null
+++ b/server/service/engine/ack.go
@@ -0,0 +1,31 @@
+package engine
+
+import (
+	"sync"
+	"time"
+)
+
+type receipt struct {
+	Tag    string
+	Action string
+	At     time.Time
+}
+
+var receipts sync.Map
+
+func ack(code, tag, action string) { receipts.Store(code, receipt{tag, action, time.Now().UTC()}) }
+func Receipt(code, tag string) (string, string) {
+	v, ok := receipts.Load(code)
+	if !ok {
+		return "pending", ""
+	}
+	r := v.(receipt)
+	if r.Tag != tag {
+		observed, observedErr := time.Parse(time.RFC3339Nano, r.Tag)
+		requested, requestedErr := time.Parse(time.RFC3339Nano, tag)
+		if observedErr != nil || requestedErr != nil || !observed.Equal(requested) {
+			return "pending", ""
+		}
+	}
+	return r.Action, r.At.Format(time.RFC3339Nano)
+}
