diff --git a/client/internal/service/event/rule_lock.go b/client/internal/service/event/rule_lock.go
new file mode 100644
index 0000000..a465910
--- /dev/null
+++ b/client/internal/service/event/rule_lock.go
@@ -0,0 +1,17 @@
+package event
+
+import (
+	"hash/fnv"
+	"sync"
+)
+
+// Registration only completes after frpc.Start. Serialize removal with installation.
+var stripes [64]sync.Mutex
+
+func lockRule(key string) func() {
+	h := fnv.New32a()
+	h.Write([]byte(key))
+	m := &stripes[h.Sum32()%64]
+	m.Lock()
+	return m.Unlock
+}
